{
  "name": "arkanis-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:emails && concurrently \"vite\" \"node server/index.js\"",
    "build": "npm run build:emails && vite build",
    "build:emails": "esbuild emails/index.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=server/emails.mjs --log-level=warning",
    "email:dev": "email dev --dir emails --port 3010",
    "preview": "vite preview",
    "server": "node server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.1",
    "react-email": "^6.9.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
